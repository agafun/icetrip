---
---
<section class="relative overflow-hidden pt-12 pb-24 lg:pt-20 lg:pb-32 bg-gradient-to-b from-arctic-dark via-arctic-deep to-arctic-dark">
	<!-- Ambient Background Elements -->
	<div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-ice-500/10 rounded-full blur-3xl pointer-events-none"></div>
	<div class="absolute bottom-10 right-10 w-[400px] h-[400px] bg-arctic-bright/10 rounded-full blur-3xl pointer-events-none"></div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
		<div class="text-center max-w-3xl mx-auto">
			<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-ice-500/10 border border-ice-400/20 text-ice-300 text-xs font-semibold tracking-wide uppercase mb-6 backdrop-blur-sm">
				<span class="w-2 h-2 rounded-full bg-arctic-bright animate-pulse"></span>
				Winter Expeditions 2026 Open
			</div>

			<h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.15] mb-6">
				Discover the Untamed <span class="text-transparent bg-clip-text bg-gradient-to-r from-ice-300 via-arctic-bright to-ice-500">Arctic Realm</span>
			</h1>

			<p class="text-lg sm:text-xl text-slate-300 mb-10 leading-relaxed">
				Journey into the frozen wilderness with world-class polar guides. Experience aurora borealis hunting, glacier treks, and luxury eco-lodges.
			</p>

			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<a href="#expeditions" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-ice-500 to-ice-600 hover:from-ice-400 hover:to-ice-500 text-white font-bold rounded-xl shadow-xl shadow-ice-500/25 transition-all duration-300 hover:scale-105">
					Explore Journeys
				</a>
				<a href="#video" class="w-full sm:w-auto px-8 py-4 bg-arctic-deep/80 border border-arctic-accent/40 hover:bg-arctic-accent/40 text-slate-200 font-semibold rounded-xl transition-all duration-300 backdrop-blur-sm flex items-center justify-center gap-2">
					<svg class="w-5 h-5 text-ice-400" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
					</svg>
					Watch Expedition Reel
				</a>
			</div>
		</div>

		<!-- Stats Cards -->
		<div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
			<div class="p-5 rounded-2xl bg-arctic-deep/40 border border-arctic-accent/20 backdrop-blur-sm text-center">
				<div class="text-3xl font-extrabold text-ice-400">98%</div>
				<div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Aurora Sighting</div>
			</div>
			<div class="p-5 rounded-2xl bg-arctic-deep/40 border border-arctic-accent/20 backdrop-blur-sm text-center">
				<div class="text-3xl font-extrabold text-ice-400">12+</div>
				<div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Polar Regions</div>
			</div>
			<div class="p-5 rounded-2xl bg-arctic-deep/40 border border-arctic-accent/20 backdrop-blur-sm text-center">
				<div class="text-3xl font-extrabold text-ice-400">100%</div>
				<div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Carbon Offset</div>
			</div>
			<div class="p-5 rounded-2xl bg-arctic-deep/40 border border-arctic-accent/20 backdrop-blur-sm text-center">
				<div class="text-3xl font-extrabold text-ice-400">4.9★</div>
				<div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Traveler Rating</div>
			</div>
		</div>
	</div>
</section>

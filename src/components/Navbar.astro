---
---
<header class="sticky top-0 z-50 backdrop-blur-md bg-arctic-dark/80 border-b border-arctic-accent/30">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
		<!-- Brand Logo -->
		<a href="/" class="flex items-center gap-3 group">
			<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-ice-600 to-arctic-bright p-0.5 shadow-lg shadow-ice-500/20 group-hover:scale-105 transition-transform duration-300">
				<div class="w-full h-full bg-arctic-dark rounded-[10px] p-1.5 flex items-center justify-center">
					<img src="/images/logo.svg" alt="icetrip logo" class="w-full h-full" />
				</div>
			</div>
			<span class="text-2xl font-bold tracking-tight text-white font-['Outfit']">
				Ice<span class="text-transparent bg-clip-text bg-gradient-to-r from-ice-400 to-arctic-bright">Trip</span>
			</span>
		</a>

		<!-- Navigation Links -->
		<nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
			<a href="#expeditions" class="hover:text-ice-300 transition-colors">Expeditions</a>
			<a href="#destinations" class="hover:text-ice-300 transition-colors">Destinations</a>
			<a href="#guides" class="hover:text-ice-300 transition-colors">Expert Guides</a>
			<a href="#reviews" class="hover:text-ice-300 transition-colors">Reviews</a>
		</nav>

		<!-- Call to Action Button -->
		<div class="flex items-center gap-4">
			<a href="#book" class="relative inline-flex items-center justify-center px-6 py-2.5 text-sm font-semibold text-white transition-all duration-300 bg-gradient-to-r from-ice-500 to-ice-600 rounded-full hover:from-ice-400 hover:to-ice-500 hover:shadow-lg hover:shadow-ice-500/30 active:scale-95">
				Book Adventure
			</a>
		</div>
	</div>
</header>

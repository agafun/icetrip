---
interface Props {
	lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;
---

<footer class="bg-white border-t border-slate-200 text-slate-500 py-10 mt-auto">
	<div class="max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col sm:flex-row items-center justify-between gap-6">
			<!-- Left: Copyright Notice -->
			<div class="text-xs font-medium text-slate-600 flex items-center gap-2">
				<span class="w-2 h-2 rounded-full bg-sky-600"></span>
				<span>© 2026 icetrip.</span>
			</div>

			<!-- Right: Accessible Links -->
			<nav aria-label={lang === 'pl' ? 'Nawigacja w stopce' : 'Footer navigation'}>
				<ul class="flex items-center gap-8 text-xs font-semibold text-slate-600">
					<li>
						<a 
							href={`/${lang}/privacy-policy`}
							class="hover:text-sky-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded-md px-2 py-1 transition-colors underline underline-offset-4 decoration-slate-300 hover:decoration-sky-600"
						>
							{lang === 'pl' ? 'Polityka prywatności' : 'Privacy Policy'}
						</a>
					</li>
					<li>
						<a 
							href={`/${lang}/contact`}
							class="hover:text-sky-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded-md px-2 py-1 transition-colors underline underline-offset-4 decoration-slate-300 hover:decoration-sky-600"
						>
							{lang === 'pl' ? 'Kontakt' : 'Contact'}
						</a>
					</li>
				</ul>
			</nav>
		</div>
	</div>
</footer>

---
interface Props {
	lang?: 'pl' | 'en';
	currentPath?: string;
}

const { lang = 'pl', currentPath = '/pl/' } = Astro.props;

// Calculate target path for language toggle
const pathWithoutLang = currentPath.replace(/^\/(pl|en)/, '') || '/';
const plPath = `/pl${pathWithoutLang}`;
const enPath = `/en${pathWithoutLang}`;
---

<a 
	href="#main-content" 
	class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-6 focus:py-3 focus:bg-sky-600 focus:text-white focus:font-bold focus:rounded-lg focus:outline-none focus:ring-4 focus:ring-sky-300 focus:shadow-2xl"
>
	{lang === 'pl' ? 'Przejdź do treści głównej' : 'Skip to main content'}
</a>

<header class="sticky top-0 z-40 w-full bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
	<div class="max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
		
		<!-- Left: Logo & Title -->
		<div class="flex items-center gap-4">
			<button 
				id="sidebar-toggle" 
				type="button"
				class="lg:hidden p-2.5 rounded-xl text-slate-700 hover:text-slate-950 bg-slate-100 hover:bg-slate-200 border border-slate-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-sky-500 focus-visible:ring-offset-2 transition-all cursor-pointer"
				aria-expanded="false"
				aria-controls="sidebar-navigation"
				aria-label={lang === 'pl' ? 'Otwórz menu nawigacji' : 'Toggle sidebar navigation'}
			>
				<svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
					<path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
					<path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>

			<a href={`/${lang}/`} class="flex items-center gap-3 group focus:outline-none focus-visible:ring-4 focus-visible:ring-sky-500 rounded-xl p-1">
				<div class="w-10 h-10 shrink-0 rounded-xl bg-[#0284c7] p-0.5 shadow-sm group-hover:scale-105 transition-transform flex items-center justify-center text-white">
					<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
					</svg>
				</div>
				<div>
					<span class="text-2xl font-black tracking-tight text-slate-900 block leading-none">
						ice<span class="text-sky-600">trip</span>
					</span>
					<span class="text-[10px] font-bold uppercase tracking-widest text-slate-500 block mt-0.5">
						Nordic Adventures · Iceland · Norway
					</span>
				</div>
			</a>
		</div>

		<!-- Right: i18n Route Switcher -->
		<div class="flex items-center gap-3">
			<nav class="relative inline-flex items-center bg-slate-100 p-1 rounded-full border border-slate-200" aria-label="Language selector / Wybór języka">
				<a 
					href={plPath} 
					id="lang-btn-pl"
					class={`px-3 py-1 text-xs font-bold rounded-full transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 ${
						lang === 'pl' 
							? 'text-slate-900 bg-white shadow-xs font-extrabold' 
							: 'text-slate-600 hover:text-slate-900'
					}`}
					aria-current={lang === 'pl' ? 'page' : undefined}
					data-lang="pl"
				>
					PL
				</a>
				<a 
					href={enPath} 
					id="lang-btn-en"
					class={`px-3 py-1 text-xs font-bold rounded-full transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 ${
						lang === 'en' 
							? 'text-slate-900 bg-white shadow-xs font-extrabold' 
							: 'text-slate-600 hover:text-slate-900'
					}`}
					aria-current={lang === 'en' ? 'page' : undefined}
					data-lang="en"
				>
					EN
				</a>
			</nav>
		</div>

	</div>
</header>

<script is:inline>
	(function() {
		// Save selected language preference to localStorage on click
		const plLink = document.getElementById('lang-btn-pl');
		const enLink = document.getElementById('lang-btn-en');

		if (plLink) {
			plLink.addEventListener('click', function() {
				localStorage.setItem('icetrip_lang', 'pl');
			});
		}
		if (enLink) {
			enLink.addEventListener('click', function() {
				localStorage.setItem('icetrip_lang', 'en');
			});
		}
	})();
</script>

---
interface ImageItem {
	url: string;
	thumbnailUrl: string;
	alt: { pl: string; en: string };
	caption: { pl: string; en: string };
}

interface Props {
	images: ImageItem[];
	lang?: 'pl' | 'en';
}

const { images, lang = 'pl' } = Astro.props;
---

<section class="my-10 space-y-4" aria-label="Galeria zdjęć / Photo gallery">
	<h3 class="text-xl font-bold text-slate-900 font-serif flex items-center gap-2">
		<svg class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
		</svg>
		<span>{lang === 'pl' ? 'Galeria zdjęć' : 'Photo Gallery'}</span>
	</h3>

	<div data-photo-gallery class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
		{images.map((img, index) => (
			<button
				type="button"
				data-gallery-open
				data-full={img.url}
				data-alt={img.alt[lang]}
				data-caption={img.caption[lang]}
				aria-label={lang === 'pl' ? `Otwórz ${img.alt[lang]}` : `Open ${img.alt[lang]}`}
				class="group overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm transition hover:border-sky-400 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600"
			>
				<img
					src={img.thumbnailUrl}
					alt={img.alt[lang]}
					width="560"
					height="400"
					loading={index < 4 ? 'eager' : 'lazy'}
					decoding="async"
					class="h-32 w-full object-cover transition-transform duration-300 group-hover:scale-105 sm:h-40"
				/>
			</button>
		))}
	</div>

	<dialog
		data-gallery-dialog
		aria-label={lang === 'pl' ? 'Galeria pełnoekranowa' : 'Fullscreen gallery'}
		class="fixed inset-0 m-0 h-screen max-h-none w-screen max-w-none border-0 bg-slate-950/95 p-0 text-white backdrop:bg-slate-950/95"
	>
		<div class="flex h-full flex-col">
			<div class="flex items-center justify-between px-4 py-3 sm:px-6">
				<p data-gallery-counter class="text-sm font-semibold" aria-live="polite"></p>
				<button data-gallery-close type="button" class="rounded-full p-2 text-2xl leading-none hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" aria-label={lang === 'pl' ? 'Zamknij galerię' : 'Close gallery'}>×</button>
			</div>
			<div class="flex min-h-0 flex-1 items-center justify-center gap-2 px-2 sm:gap-6 sm:px-6">
				<button data-gallery-previous type="button" class="shrink-0 rounded-full bg-white/10 px-3 py-4 text-xl hover:bg-white/20 sm:px-5" aria-label={lang === 'pl' ? 'Poprzednie zdjęcie' : 'Previous photo'}>‹</button>
				<img data-gallery-full-image alt="" class="hidden max-h-full max-w-full object-contain" />
				<button data-gallery-next type="button" class="shrink-0 rounded-full bg-white/10 px-3 py-4 text-xl hover:bg-white/20 sm:px-5" aria-label={lang === 'pl' ? 'Następne zdjęcie' : 'Next photo'}>›</button>
			</div>
			<p data-gallery-caption class="min-h-10 px-4 py-2 text-center text-sm text-white/80"></p>
		</div>
	</dialog>
</section>

<script>
	for (const gallery of document.querySelectorAll<HTMLElement>('[data-photo-gallery]')) {
		const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-open]'));
		const dialog = gallery.parentElement?.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
		if (!dialog || buttons.length === 0) continue;

		const fullImage = dialog.querySelector<HTMLImageElement>('[data-gallery-full-image]')!;
		const counter = dialog.querySelector<HTMLElement>('[data-gallery-counter]')!;
		const caption = dialog.querySelector<HTMLElement>('[data-gallery-caption]')!;
		const closeButton = dialog.querySelector<HTMLButtonElement>('[data-gallery-close]')!;
		let activeIndex = 0;
		let opener: HTMLButtonElement | undefined;

		function showImage(index: number) {
			activeIndex = (index + buttons.length) % buttons.length;
			const button = buttons[activeIndex];
			fullImage.src = button.dataset.full ?? '';
			fullImage.alt = button.dataset.alt ?? '';
			fullImage.classList.remove('hidden');
			caption.textContent = button.dataset.caption ?? '';
			counter.textContent = `${activeIndex + 1} / ${buttons.length}`;
		}

		buttons.forEach((button, index) => button.addEventListener('click', () => {
			opener = button;
			showImage(index);
			dialog.showModal();
			closeButton.focus();
		}));
		dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
		dialog.querySelector('[data-gallery-previous]')?.addEventListener('click', () => showImage(activeIndex - 1));
		dialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => showImage(activeIndex + 1));
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog.addEventListener('close', () => {
			fullImage.removeAttribute('src');
			fullImage.classList.add('hidden');
			opener?.focus();
		});
		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				showImage(activeIndex - 1);
			}
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				showImage(activeIndex + 1);
			}
		});
	}
</script>

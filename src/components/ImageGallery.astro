---
interface ImageItem {
	url: string;
	alt: { pl: string; en: string };
	caption: { pl: string; en: string };
}

interface Props {
	images: ImageItem[];
	lang?: 'pl' | 'en';
}

const { images, lang = 'pl' } = Astro.props;
---

<section class="my-10 space-y-4" aria-label="Galeria zdjęć / Photo gallery">
	<h3 class="text-xl font-bold text-slate-900 font-serif flex items-center gap-2">
		<svg class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
		</svg>
		<span>{lang === 'pl' ? 'Galeria zdjęć' : 'Photo Gallery'}</span>
	</h3>

	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
		{images.map((img) => (
			<figure class="group relative rounded-2xl bg-white border border-slate-200/90 overflow-hidden shadow-sm transition-all duration-300 hover:border-sky-300 hover:shadow-md">
				<div class="overflow-hidden bg-slate-100">
					<img 
						src={img.url} 
						alt={img.alt[lang]} 
						loading="lazy"
						class="w-full h-56 object-cover transform group-hover:scale-105 transition-transform duration-500"
					/>
				</div>
				<figcaption class="p-3.5 text-xs text-slate-600 bg-slate-50 border-t border-slate-200">
					{img.caption[lang]}
				</figcaption>
			</figure>
		))}
	</div>
</section>

---
import Layout from '../../layouts/Layout.astro';
import type { Language } from '../../utils/i18n';

export function getStaticPaths() {
	return [
		{ params: { lang: 'pl' } },
		{ params: { lang: 'en' } },
	];
}

const { lang } = Astro.params as { lang: Language };
const isPolish = lang === 'pl';
const title = isPolish ? 'Kontakt - icetrip' : 'Contact - icetrip';
const description = isPolish
	? 'Dane kontaktowe autorów przewodnika icetrip.'
	: 'Contact details for the icetrip guide authors.';
const formLabels = isPolish
	? { name: 'Imię', email: 'Adres e-mail', message: 'Wiadomość', requiredNote: '* oznacza pole obowiązkowe', submit: 'Wyślij wiadomość', sending: 'Wysyłanie…', success: 'Dziękujemy! Wiadomość została wysłana.', error: 'Nie udało się wysłać wiadomości. Spróbuj ponownie lub napisz do nas bezpośrednio na contact@icetrip.eu.' }
	: { name: 'Name', email: 'Email address', message: 'Message', requiredNote: '* indicates a required field', submit: 'Send message', sending: 'Sending…', success: 'Thank you! Your message has been sent.', error: 'We could not send your message. Please try again or email us directly at contact@icetrip.eu.' };
---

<Layout title={title} description={description} lang={lang} activeSlug="contact" canonicalPath={`/${lang}/contact`}>
	<article class="mx-auto max-w-3xl space-y-8 py-4">
		<header class="space-y-3">
			<p class="text-xs font-bold uppercase tracking-widest text-sky-700">icetrip</p>
			<h1 class="text-3xl font-extrabold tracking-tight text-slate-900 font-serif sm:text-4xl">
				{isPolish ? 'Kontakt' : 'Contact'}
			</h1>
			<p class="text-base leading-relaxed text-slate-600 sm:text-lg">
				{isPolish
					? 'Masz pytanie? Napisz do nas!'
					: 'Have a question? Write to us!'}
			</p>
		</header>

		<section class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8" aria-labelledby="contact-form-heading">
			<h2 id="contact-form-heading" class="text-xl font-bold text-slate-900 font-serif">{isPolish ? 'Napisz do nas' : 'Send us a message'}</h2>
			<form id="contact-form" class="space-y-5">
				<input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? ''} />
				<input type="hidden" name="subject" value={isPolish ? 'Nowa wiadomość z icetrip.eu (PL)' : 'New message from icetrip.eu (EN)'} />
				<input type="hidden" name="from_name" value="icetrip.eu contact form" />
				<input type="hidden" name="language" value={lang} />
				<input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
				<label class="block space-y-2 text-sm font-semibold text-slate-700">
					<span>{formLabels.name} <span class="text-red-600" aria-hidden="true">*</span></span>
					<input name="name" type="text" required autocomplete="name" class="w-full rounded-lg border border-slate-300 px-4 py-3 font-normal text-slate-900 outline-none focus:border-sky-600 focus:ring-2 focus:ring-sky-200" />
				</label>
				<label class="block space-y-2 text-sm font-semibold text-slate-700">
					<span>{formLabels.email} <span class="text-red-600" aria-hidden="true">*</span></span>
					<input name="email" type="email" required autocomplete="email" class="w-full rounded-lg border border-slate-300 px-4 py-3 font-normal text-slate-900 outline-none focus:border-sky-600 focus:ring-2 focus:ring-sky-200" />
				</label>
				<label class="block space-y-2 text-sm font-semibold text-slate-700">
					<span>{formLabels.message} <span class="text-red-600" aria-hidden="true">*</span></span>
					<textarea name="message" required rows="6" class="w-full rounded-lg border border-slate-300 px-4 py-3 font-normal text-slate-900 outline-none focus:border-sky-600 focus:ring-2 focus:ring-sky-200"></textarea>
				</label>
				<button type="submit" class="rounded-lg bg-sky-700 px-5 py-3 font-semibold text-white transition hover:bg-sky-800 disabled:cursor-wait disabled:opacity-60">{formLabels.submit}</button>
				<p class="text-sm text-slate-600">{formLabels.requiredNote}</p>
				<p id="contact-form-status" class="min-h-6 text-sm" role="status" aria-live="polite"></p>
			</form>
		</section>
	</article>
</Layout>

<script define:vars={{ labels: formLabels }}>
	const form = document.querySelector('#contact-form');
	const status = document.querySelector('#contact-form-status');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const submit = form.querySelector('button[type="submit"]');
		const accessKey = form.querySelector('[name="access_key"]')?.value;
		if (!accessKey) {
			status.textContent = labels.error;
			status.className = 'min-h-6 text-sm text-red-700';
			return;
		}
		submit.disabled = true;
		submit.textContent = labels.sending;
		status.textContent = '';
		try {
			const response = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form) });
			const result = await response.json();
			if (!response.ok || !result.success) throw new Error('Submission failed');
			form.reset();
			status.textContent = labels.success;
			status.className = 'min-h-6 text-sm text-green-700';
		} catch {
			status.textContent = labels.error;
			status.className = 'min-h-6 text-sm text-red-700';
		} finally {
			submit.disabled = false;
			submit.textContent = labels.submit;
		}
	});
</script>

---
import Layout from '../../../layouts/Layout.astro';
import ImageGallery from '../../../components/ImageGallery.astro';
import AdBanner from '../../../components/AdBanner.astro';
import { daysData, type Language } from '../../../utils/i18n';
import { getDayMapScreenshot, getDayPhotos } from '../../../utils/dayAssets';

export function getStaticPaths() {
	const paths = [];
	const langs: Language[] = ['pl', 'en'];

	for (const lang of langs) {
		for (let i = 0; i < daysData.length; i++) {
			const day = daysData[i];
			const prevDay = daysData[i - 1] ? daysData[i - 1].slug : null;
			const nextDay = daysData[i + 1] ? daysData[i + 1].slug : null;

			paths.push({
				params: { lang, slug: day.slug },
				props: { day, prevDay, nextDay }
			});
		}
	}

	return paths;
}

const { lang, slug } = Astro.params as { lang: Language; slug: string };
const { day, prevDay, nextDay } = Astro.props;

const title = `${day.title[lang]} - Islandia 2026`;
const description = day.description[lang];
const canonicalPath = `/${lang}/day/${slug}`;
const mapScreenshot = getDayMapScreenshot(day.dayNumber);
const galleryPhotos = getDayPhotos(day.dayNumber);
const safetyNotes = day.safetyTips ?? (day.safetyTip ? [day.safetyTip] : []);
---

<Layout 
	title={title}
	description={description}
	lang={lang}
	activeSlug={slug}
	canonicalPath={canonicalPath}
	ogImage={galleryPhotos[0]?.url ?? mapScreenshot ?? day.images[0]?.url}
>
	<article class="max-w-4xl mx-auto space-y-10 py-4">
		
		<!-- Breadcrumb Navigation -->
		<nav aria-label="Breadcrumb" class="text-xs font-semibold text-slate-500">
			<ol class="flex items-center gap-2">
				<li>
					<a href={`/${lang}/`} class="hover:text-sky-700 transition-colors">
						{lang === 'pl' ? 'Islandia: w skrócie' : 'Iceland: Overview'}
					</a>
				</li>
				<li class="text-slate-300">/</li>
				<li class="text-sky-800 font-bold" aria-current="page">
					{lang === 'pl' ? `Dzień ${day.dayNumber}` : `Day ${day.dayNumber}`}
				</li>
			</ol>
		</nav>

		<!-- Day Header -->
		<header class="space-y-4 pb-6 border-b border-slate-200">
			<div class="flex flex-wrap items-center gap-2.5 text-xs font-bold">
				<span class="px-3.5 py-1.5 rounded-full bg-sky-50 text-sky-800 border border-sky-200 uppercase tracking-wider">
					{day.date} • {lang === 'pl' ? `Dzień ${day.dayNumber}` : `Day ${day.dayNumber}`}
				</span>
				<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
					🚗 {lang === 'pl' ? 'Dystans' : 'Distance'}: {day.distance}
				</span>
				<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
					⏱️ {lang === 'pl' ? 'Czas jazdy' : 'Drive time'}: {day.driveTime}
				</span>
				<span class="px-3 py-1 rounded-full bg-sky-50 text-sky-800 border border-sky-200">
					🏠 {lang === 'pl' ? 'Nocleg' : 'Accommodation'}: {day.hub[lang]}
				</span>
			</div>

			<h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight font-serif">
				{day.title[lang]}
			</h1>

			<p class="text-base sm:text-lg text-slate-600 leading-relaxed">
				{day.description[lang]}
			</p>

			{day.mapsUrl && (
				<div class="pt-2">
					<a 
						href={day.mapsUrl} 
						target="_blank" 
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-sky-700 hover:text-sky-800 border border-slate-200 hover:border-sky-300 font-semibold text-xs shadow-2xs transition-all"
					>
						<span>{lang === 'pl' ? '🗺️ Otwórz trasę w Google Maps' : '🗺️ Open route in Google Maps'}</span>
						<span>↗</span>
					</a>
					{mapScreenshot && (
						<figure class="mt-3 overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-xs">
							<img
								src={mapScreenshot}
								alt={lang === 'pl' ? `Mapa trasy: ${day.title[lang]}` : `Route map: ${day.title[lang]}`}
								class="block h-auto w-full"
								loading="lazy"
							/>
						</figure>
					)}
				</div>
			)}
		</header>

		<!-- Highlights Bullet Card -->
		<section class="p-6 sm:p-7 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-4">
			<h2 class="text-lg font-bold text-slate-900 font-serif flex items-center gap-2">
				<span>{lang === 'pl' ? 'Jaki jest plan' : 'What is the plan'}</span>
			</h2>
			<ul class="space-y-3 text-sm sm:text-base text-slate-700">
				{day.highlights[lang].map((hl) => (
					<li class="flex items-start gap-3">
						<span class="w-1.5 h-1.5 rounded-full bg-sky-600 mt-2 shrink-0"></span>
						<span class="leading-relaxed">{hl}</span>
					</li>
				))}
			</ul>
		</section>

		<!-- Safety Tip Box if present -->
		{safetyNotes.length > 0 && (
			<div class="space-y-4">
				{safetyNotes.map((tip) => (
					<div class="p-6 rounded-2xl bg-violet-50/80 border border-violet-200 text-violet-950 space-y-2 shadow-xs">
						<div class="flex items-center gap-2 font-bold text-violet-900 text-sm uppercase tracking-wide">
							<svg class="w-5 h-5 shrink-0 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
							</svg>
							<span>{lang === 'pl' ? 'Uwaga' : 'Note'}</span>
						</div>
						<p class="text-sm leading-relaxed text-violet-950/90">
							{tip[lang]}
						</p>
					</div>
				))}
			</div>
		)}

		<!-- Full Story / Detailed Itinerary -->
		<section class="space-y-4 text-slate-700 leading-relaxed text-base sm:text-lg">
			<h2 class="text-2xl font-bold text-slate-900 font-serif mb-2">
				{lang === 'pl' ? 'Jak faktycznie było' : 'How it actually was'}
			</h2>
			<div class="whitespace-pre-line text-sm sm:text-base leading-relaxed text-slate-700">
				{day.content[lang]}
			</div>
		</section>

		<!-- Recommended Food Places -->
		{day.food[lang] && day.food[lang].length > 0 && (
			<section class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
				<h3 class="text-base font-bold text-slate-900 font-serif flex items-center gap-2">
					<span>🍽️</span>
					<span>{lang === 'pl' ? 'Gdzie zjeść na trasie' : 'Where to eat on the route'}</span>
				</h3>
				<ul class="space-y-2 text-xs sm:text-sm text-slate-600">
					{day.food[lang].map((f) => (
						<li class="flex items-start gap-2.5">
							<span class="text-sky-600 font-bold">•</span>
							<span>{f}</span>
						</li>
					))}
				</ul>
			</section>
		)}

		<!-- AdBanner above Gallery -->
		<AdBanner slotType="content" />

		<!-- Image Gallery -->
		{galleryPhotos.length > 0 && (
			<ImageGallery images={galleryPhotos} lang={lang} />
		)}

		<!-- Prev / Next Navigation Footer -->
		<nav aria-label="Day Navigation" class="pt-8 border-t border-slate-200 flex items-center justify-between gap-4">
			{prevDay ? (
				<a 
					href={`/${lang}/day/${prevDay}`}
					class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 hover:border-slate-300 text-xs sm:text-sm font-semibold shadow-2xs transition-colors"
				>
					← {lang === 'pl' ? 'Poprzedni dzień' : 'Previous Day'}
				</a>
			) : (
				<div></div>
			)}

			<a 
				href={`/${lang}/`}
				class="text-xs font-semibold text-slate-500 hover:text-sky-700 transition-colors underline underline-offset-4 decoration-slate-300"
			>
				{lang === 'pl' ? 'Strona główna' : 'Home'}
			</a>

			{nextDay ? (
				<a 
					href={`/${lang}/day/${nextDay}`}
					class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-800 hover:text-sky-900 border border-sky-200 text-xs sm:text-sm font-bold shadow-2xs transition-all"
				>
					{lang === 'pl' ? 'Następny dzień' : 'Next Day'} →
				</a>
			) : (
				<div></div>
			)}
		</nav>

	</article>
</Layout>

---
// Root index page handles client-side i18n redirection to /pl/ or /en/
---

<!DOCTYPE html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="refresh" content="0;url=/pl/" />
		<title>IceTrip - Redirecting...</title>
		<meta name="description" content="Nordic Adventures · Iceland · Norway — rodzinny przewodnik po wyprawie na Islandię." />
		<link rel="canonical" href="https://icetrip.eu/pl/" />
		<meta property="og:title" content="Nordic Adventures · Iceland · Norway" />
		<meta property="og:description" content="Rodzinny przewodnik po wyprawie na Islandię." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://icetrip.eu/" />
		<meta property="og:image" content="https://icetrip.eu/images/highlight1IMG_5298.jpeg" />
		<meta property="og:image:secure_url" content="https://icetrip.eu/images/highlight1IMG_5298.jpeg" />
		<meta property="og:image:alt" content="Islandzki krajobraz z wyprawy Nordic Adventures" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Nordic Adventures · Iceland · Norway" />
		<meta name="twitter:description" content="Rodzinny przewodnik po wyprawie na Islandię." />
		<meta name="twitter:image" content="https://icetrip.eu/images/highlight1IMG_5298.jpeg" />
		<script is:inline>
			(function() {
				const savedLang = localStorage.getItem('icetrip_lang');
				let targetLang = 'pl';
				if (savedLang === 'en' || savedLang === 'pl') {
					targetLang = savedLang;
				} else if (navigator.language && navigator.language.startsWith('en')) {
					targetLang = 'en';
				}
				window.location.replace('/' + targetLang + '/');
			})();
		</script>
	</head>
	<body class="bg-[#F8FAFC] text-slate-800 p-8 font-sans">
		<p>Redirecting to IceTrip Expedition Guide...</p>
	</body>
</html>
